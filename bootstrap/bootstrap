#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
install_root=${HOME}/.local
bundle=retro-master
apply=false

while [ "$#" -gt 0 ]; do
    case "$1" in
        --root)
            [ "$#" -ge 2 ] || { echo "ERROR --root requires a path" >&2; exit 1; }
            install_root=$2
            shift 2
            ;;
        --bundle)
            [ "$#" -ge 2 ] || { echo "ERROR --bundle requires a profile" >&2; exit 1; }
            bundle=$2
            shift 2
            ;;
        --apply)
            apply=true
            shift
            ;;
        --help|-h)
            echo "usage: bootstrap/bootstrap [--root PATH] [--bundle PROFILE] [--apply]"
            echo "dry-run by default; --apply installs Pokefetch from this checkout"
            exit 0
            ;;
        *)
            echo "ERROR unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

echo "INFO source $repo_root"
echo "INFO root $install_root"
echo "INFO bundle $bundle"

if [ "$apply" != true ]; then
    echo "PLAN install Pokefetch and pokefetch-assets"
    exit 0
fi

command -v cargo >/dev/null 2>&1 || {
    echo "ERROR cargo is required" >&2
    exit 1
}

POKEFETCH_BUNDLE=$bundle cargo install \
    --path "$repo_root" \
    --root "$install_root" \
    --force \
    --locked \
    --features bundle-assets

"$repo_root/bootstrap/doctor" --root "$install_root" --bundle "$bundle"
