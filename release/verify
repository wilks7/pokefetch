#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
packages_dir=${1:-$repo_root/dist}
version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$repo_root/Cargo.toml" | sed -n '1p')
target=$(rustc -vV | sed -n 's/^host: //p')
commit=$(git -C "$repo_root" rev-parse HEAD)
source_revision=$(sed -n 's/^revision = "\([^"]*\)"/\1/p' "$repo_root/manifests/sets.toml" | sed -n '1p')

[ -d "$packages_dir" ] || { echo "ERROR missing package directory $packages_dir" >&2; exit 1; }
(cd "$packages_dir" && shasum -a 256 -c SHA256SUMS)

verification_root=$(mktemp -d "${TMPDIR:-/tmp}/pokefetch-packages.XXXXXX")
trap 'rm -rf "$verification_root"' EXIT HUP INT TERM
verified=0

while IFS= read -r profile || [ -n "$profile" ]; do
    case "$profile" in
        ''|'#'*) continue ;;
    esac

    name=pokefetch-v$version-$target-$profile
    archive=$packages_dir/$name.tar.gz
    [ -f "$archive" ] || { echo "ERROR missing archive $archive" >&2; exit 1; }
    tar -xzf "$archive" -C "$verification_root"

    package_root=$verification_root/$name
    binary=$package_root/pokefetch
    [ -x "$binary" ] || { echo "ERROR missing executable in $archive" >&2; exit 1; }
    [ "$(find "$package_root" -type f | wc -l | tr -d ' ')" -eq 5 ]
    [ "$("$binary" --version)" = "pokefetch $version" ]
    [ "$("$binary" bundle)" = "$profile" ]

    grep -Fqx "version = $version" "$package_root/BUILD-INFO.txt"
    grep -Fqx "bundle = $profile" "$package_root/BUILD-INFO.txt"
    grep -Fqx "target = $target" "$package_root/BUILD-INFO.txt"
    grep -Fqx "commit = $commit" "$package_root/BUILD-INFO.txt"
    grep -Fqx "sprite_source_revision = $source_revision" "$package_root/BUILD-INFO.txt"

    config_home=$verification_root/config-$profile
    install -d "$config_home/pokefetch"
    config_file=$config_home/pokefetch/config.toml
    printf '%s\n' '# existing user config must be preserved' > "$config_file"
    before=$(shasum -a 256 "$config_file")
    XDG_CONFIG_HOME=$config_home \
    XDG_CACHE_HOME=$verification_root/cache-$profile \
    XDG_STATE_HOME=$verification_root/state-$profile \
        "$binary" --no-icon show pikachu >/dev/null
    after=$(shasum -a 256 "$config_file")
    [ "$before" = "$after" ]

    verified=$((verified + 1))
    echo "OK package $profile"
done < "$repo_root/release/bundles.txt"

[ "$verified" -gt 0 ] || { echo "ERROR no release profiles verified" >&2; exit 1; }
[ "$(wc -l < "$packages_dir/SHA256SUMS" | tr -d ' ')" -eq "$verified" ]
echo "OK $verified release package(s) and existing config preservation"
