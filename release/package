#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
output_dir=$repo_root/dist
profiles=
release_tag=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --output)
            [ "$#" -ge 2 ] || { echo "ERROR --output requires a path" >&2; exit 1; }
            output_dir=$2
            shift 2
            ;;
        --profile)
            [ "$#" -ge 2 ] || { echo "ERROR --profile requires a bundle id" >&2; exit 1; }
            profiles="$profiles $2"
            shift 2
            ;;
        --tag)
            [ "$#" -ge 2 ] || { echo "ERROR --tag requires a version tag" >&2; exit 1; }
            release_tag=$2
            shift 2
            ;;
        --help|-h)
            echo "usage: release/package [--output PATH] [--profile ID]... [--tag vX.Y.Z]"
            echo "defaults to the bundle profiles in release/bundles.txt"
            exit 0
            ;;
        *)
            echo "ERROR unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

cd "$repo_root"

if [ -z "$profiles" ]; then
    while IFS= read -r profile || [ -n "$profile" ]; do
        case "$profile" in
            ''|'#'*) continue ;;
        esac
        profiles="$profiles $profile"
    done < "$repo_root/release/bundles.txt"
fi

[ -n "$profiles" ] || { echo "ERROR no release bundle profiles selected" >&2; exit 1; }

version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | sed -n '1p')
[ -n "$version" ] || { echo "ERROR package version missing from Cargo.toml" >&2; exit 1; }

if [ -n "$release_tag" ] && [ "$release_tag" != "v$version" ]; then
    echo "ERROR tag $release_tag does not match Cargo version v$version" >&2
    exit 1
fi

target=$(rustc -vV | sed -n 's/^host: //p')
[ -n "$target" ] || { echo "ERROR could not determine the Rust host target" >&2; exit 1; }

target_dir=${CARGO_TARGET_DIR:-$repo_root/target}
case "$target_dir" in
    /*) ;;
    *) target_dir=$repo_root/$target_dir ;;
esac

commit=$(git rev-parse HEAD)
source_revision=$(sed -n 's/^revision = "\([^"]*\)"/\1/p' manifests/sets.toml | sed -n '1p')
[ -n "$source_revision" ] || { echo "ERROR sprite source revision is missing" >&2; exit 1; }

install -d "$output_dir"
staging=$(mktemp -d "${TMPDIR:-/tmp}/pokefetch-release.XXXXXX")
trap 'rm -rf "$staging"' EXIT HUP INT TERM
archives=

for profile in $profiles; do
    echo "BUILD $profile"
    POKEFETCH_BUNDLE=$profile cargo build \
        --release \
        --locked \
        --features bundle-assets \
        --bin pokefetch

    actual_profile=$("$target_dir/release/pokefetch" bundle)
    [ "$actual_profile" = "$profile" ] || {
        echo "ERROR expected bundle $profile, built $actual_profile" >&2
        exit 1
    }

    name=pokefetch-v$version-$target-$profile
    package_root=$staging/$name
    install -d "$package_root"
    install -m 755 "$target_dir/release/pokefetch" "$package_root/pokefetch"
    install -m 644 README.md LICENSE THIRD_PARTY_NOTICES.md "$package_root"
    {
        printf 'version = %s\n' "$version"
        printf 'bundle = %s\n' "$profile"
        printf 'target = %s\n' "$target"
        printf 'commit = %s\n' "$commit"
        printf 'sprite_source_revision = %s\n' "$source_revision"
    } > "$package_root/BUILD-INFO.txt"

    archive=$name.tar.gz
    tar -C "$staging" -czf "$output_dir/$archive" "$name"
    archives="$archives $archive"
    echo "CREATE $output_dir/$archive"
done

checksums=$staging/SHA256SUMS
: > "$checksums"
for archive in $archives; do
    (cd "$output_dir" && shasum -a 256 "$archive") >> "$checksums"
done
install -m 644 "$checksums" "$output_dir/SHA256SUMS"
echo "CREATE $output_dir/SHA256SUMS"
